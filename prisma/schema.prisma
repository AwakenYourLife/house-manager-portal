// The house manager portal.
//
// Its own database. A "day" is a calendar date in the household's time zone
// (HOUSE_TZ), stored as "YYYY-MM-DD" text so the owner and the manager can never
// disagree about which day something belongs to.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One job on the manager's list — "Unload the dishwasher".
model Duty {
  id        String   @id @default(cuid())
  title     String
  details   String   @default("")
  area      String   @default("General")
  /// Weekdays it repeats on, 0 = Sunday … 6 = Saturday. Empty for a one-off.
  days      Int[]    @default([])
  /// Set for a one-time duty: the only date it is due.
  onceDate  String?
  /// Set for a monthly duty: the day of the month it is due, 1–31, or -1 for
  /// the last day. A day the month doesn't have (the 31st in April) falls on
  /// that month's last day, so a monthly duty is never skipped.
  monthDay  Int?
  /// "HH:MM" it should be done by, or blank.
  dueBy     String   @default("")
  priority  Boolean  @default(false)
  /// Paused duties drop off the daily list but keep their history.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  completions Completion[]
}

/// Everything about one working day that isn't a shift or a tick.
model Day {
  date String @id

  /// The owner's note shown at the top of the manager's screen that day.
  ownerNote String @default("")

  reportDid      String    @default("")
  reportExtra    String    @default("")
  reportIssues   String    @default("")
  reportAt       DateTime?
  reportEditedAt DateTime?
  /// The duties that were due when the report went in — [{dutyId, title}].
  /// Frozen so that editing the duty list later never rewrites a past day.
  dueSnapshot    Json?

  reviewNote String    @default("")
  reviewedAt DateTime?

  updatedAt DateTime @updatedAt
}

/// One clock-in to clock-out. clockOut is null while they're on the clock.
model Shift {
  id       String    @id @default(cuid())
  date     String
  clockIn  DateTime
  clockOut DateTime?
  /// Set when the owner corrects a time, so a fixed shift is never mistaken
  /// for one the manager clocked themselves.
  editedByOwner Boolean @default(false)

  @@index([date])
  @@index([clockOut])
}

/// A duty's state on one day: ticked or not, the manager's note, and — if it
/// wasn't done — the reason they gave in the end-of-day report.
model Completion {
  id     String  @id @default(cuid())
  date   String
  dutyId String?
  duty   Duty?   @relation(fields: [dutyId], references: [id], onDelete: SetNull)
  /// Copied from the duty, so the log still reads right after a duty is deleted.
  title  String

  done   Boolean   @default(false)
  doneAt DateTime?
  note   String    @default("")
  reason String    @default("")

  @@unique([date, dutyId])
  @@index([date])
}

/// The conversation between the owner and the manager.
model Message {
  id        String    @id @default(cuid())
  /// "owner" | "manager"
  from      String
  body      String
  createdAt DateTime  @default(now())
  /// When the other person first opened Messages after it arrived.
  readAt    DateTime?

  @@index([createdAt])
}

/// One thing to buy. Either person adds to the list; checking it off records
/// who got it and when. Items raised by a pantry staple running low carry its
/// id, and checking one off adds what was bought back onto the staple's count.
model GroceryItem {
  id        String    @id @default(cuid())
  name      String
  /// Free text — "2 lbs", "large bag".
  qty       String    @default("")
  note      String    @default("")
  /// "owner" | "manager" | "auto" (raised by a staple below its minimum)
  addedBy   String
  createdAt DateTime  @default(now())
  gotAt     DateTime?
  gotBy     String?
  /// How many were bought, for a staple-linked item.
  boughtQty Int?
  stapleId  String?
  staple    Staple?   @relation(fields: [stapleId], references: [id], onDelete: SetNull)

  @@index([gotAt])
}

/// Something the house should never run out of. The owner sets the minimum;
/// the manager keeps onHand current.
model Staple {
  id        String    @id @default(cuid())
  name      String
  /// What a count is in — "rolls", "cans", "bottles".
  unit      String    @default("")
  /// Where it's kept — Pantry, Fridge, Freezer, Cleaning, Bathroom, Other.
  location  String    @default("Pantry")
  minStock  Int
  onHand    Int       @default(0)
  /// When onHand was last set by a count or a purchase.
  countedAt DateTime?
  countedBy String?
  createdAt DateTime  @default(now())

  groceries GroceryItem[]
}

/// One thing to prep in a given week — "Grilled chicken, 2 lbs, sliced".
/// weekOf is that week's Monday ("YYYY-MM-DD"), so each week is its own list
/// and past weeks stay as they were.
model PrepItem {
  id        String    @id @default(cuid())
  weekOf    String
  name      String
  /// How much — "2 lbs", "6 portions".
  amount    String    @default("")
  details   String    @default("")
  /// Which day to prep it, 0 = Sunday … 6 = Saturday; null = any day that week.
  prepDay   Int?
  createdAt DateTime  @default(now())
  done      Boolean   @default(false)
  doneAt    DateTime?
  note      String    @default("")

  @@index([weekOf])
}

/// A note from the owner to the manager — something to know, or a one-off task.
/// It stays at the top of the manager's Today until they tap "Got it" (and, for
/// a task, until they mark it done), then lives on in the Notes tab for
/// reference. The owner sees exactly when each step happened.
model Note {
  id        String    @id @default(cuid())
  body      String
  isTask    Boolean   @default(false)
  /// Optional "YYYY-MM-DD" a task should be done by.
  dueDate   String?
  createdAt DateTime  @default(now())
  seenAt    DateTime?
  doneAt    DateTime?
  /// The manager's reply when marking a task done.
  doneNote  String    @default("")

  @@index([createdAt])
}
