---
import { dayKey } from "../lib/days.ts";
interface Props { back: string }
const { back } = Astro.props;
---
<form method="post" action="/api/owner/notice" class="card stack">
  <input type="hidden" name="back" value={back} />
  <div class="field">
    <label for="notice-body">New note for the house manager</label>
    <textarea id="notice-body" name="body" required maxlength="4000" placeholder="The window cleaners come Thursday at 10. Please let them in and lock up after."></textarea>
  </div>
  <div class="row" style="gap:10px 18px">
    <label class="row" style="gap:8px;font-weight:500;cursor:pointer"><input type="checkbox" name="isTask" /> This is a task to get done</label>
    <label class="row" style="gap:8px;font-weight:500">Due <input type="date" name="dueDate" min={dayKey()} style="width:auto" aria-label="Due date (optional)" /> <span class="hint">(optional)</span></label>
  </div>
  <div class="row"><button class="primary">Send note</button></div>
  <p class="hint" style="margin:0">It stays at the top of her Today screen until she taps "Got it". A task stays until she marks it done.</p>
</form>
