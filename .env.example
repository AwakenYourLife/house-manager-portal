# Copy to .env for local work. On Render these are set in the dashboard.

# The portal's own Postgres database (Prisma Postgres, like the support console).
DATABASE_URL=

# Two passwords, two people. Whichever one is typed on the sign-in page decides
# which side of the portal opens. Changing one signs that person out everywhere.
OWNER_PASSWORD=
MANAGER_PASSWORD=

# The household's time zone. "Today", clock times and the daily log all use it,
# so the owner and the manager always mean the same day.
HOUSE_TZ=America/New_York

# Bind to all interfaces, or nothing outside the container can reach the server.
HOST=0.0.0.0
